{
  "name": "visnarn",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Shop Arrival Check: route a railcar to a repair shop over the Class I network, estimate arrival, and check preprocessing finishes first.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=engine --watch-path=shared --disable-warning=ExperimentalWarning server/main.ts --dev",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/main.ts --web dist",
    "selftest": "node --disable-warning=ExperimentalWarning server/main.ts --selftest",
    "build": "tsc -b tsconfig.areas.json && vite build",
    "typecheck": "tsc -b tsconfig.areas.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backtest": "node --disable-warning=ExperimentalWarning scripts/backtest.ts",
    "data": "bash pipeline/run_all.sh"
  },
  "dependencies": {
    "@deck.gl/mapbox": "^9.0.38",
    "deck.gl": "^9.0.38",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
